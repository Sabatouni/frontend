# STAGING configuration template -- placeholders only, no real values.
#
#   1. Copy this file to .env.staging   (.env.staging is git-ignored)
#   2. Fill in the values of the separate STAGING Supabase project
#   3. Run:  npm run dev:staging        (or npm run build:staging)
#
# Every variable below is REQUIRED. Vite loads .env (production) first and
# .env.staging on top, so a missing line would silently inherit the
# production value -- the startup guard (src/config/envGuard.js) detects that
# and refuses to start.
#
# Never put a service-role key in any VITE_ variable: everything prefixed
# VITE_ is shipped to the browser.

# Must be exactly "staging".
VITE_APP_ENV=staging

# The staging project's 20-character reference (Project Settings -> General),
# or "local" when using a local Supabase (supabase start).
VITE_EXPECTED_SUPABASE_REF=your-staging-project-ref

# Must be https://<VITE_EXPECTED_SUPABASE_REF>.supabase.co
# (or http://127.0.0.1:54321 when VITE_EXPECTED_SUPABASE_REF=local).
VITE_SUPABASE_URL=https://your-staging-project-ref.supabase.co

# The STAGING project's anon / publishable key (public key, NOT service-role).
VITE_SUPABASE_ANON_KEY=your-staging-anon-or-publishable-key

# Staging admin backend. Must be localhost or a host containing "staging" --
# the production admin backend holds the production service-role key.
# If there is no staging admin backend, leave this as-is: the Users page
# simply won't load, and nothing reaches production.
VITE_API_URL=http://localhost:3002
